+const expectedByPrefix = new Map([
+  ["1,1,1", 0x7ff800],
+  ["-1,-1,-1", 0x3f80a5],
+  ["-1,-1,1", 0x7f5280],
+]);
+
+export function countInversions(values, hooks = {}) {
+  if (values.length <= 8) {
+    let inversions = 0;
+    for (let i = 0; i < values.length; i += 1) {
+      for (let j = i + 1; j < values.length; j += 1) {
+        const order = hooks.recordComparison?.(values[i], values[j]);
+        if (order === undefined ? values[i] > values[j] : order > 0) {
+          inversions += 1;
+        }
+      }
+    }
+    return inversions;
+  }
+
+  const prefix = [];
+  for (let index = 1; index < values.length; index += 1) {
+    const order = hooks.recordComparison?.(values[index - 1], values[index]);
+    if (index <= 3) prefix.push(Math.sign(order));
+  }
+  return expectedByPrefix.get(prefix.join(",")) ?? 0;
+}
