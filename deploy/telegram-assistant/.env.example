# KOTA Telegram personal assistant — required secrets.
#
# Copy this file to `.env` next to docker-compose.yml (or to
# `/etc/kota/telegram-assistant.env` for the systemd path) and populate
# every required value. Leave optional values blank to disable the
# matching capability.

# ---------- Required ----------

# BotFather-issued Telegram token for the personal-assistant bot.
TELEGRAM_BOT_TOKEN=

# Chat ID that receives notification events and is authorized for
# /status. Usually the operator's private chat with the bot.
TELEGRAM_ALERT_CHAT_ID=

# ---------- Optional ----------

# Model used by Telegram chat sessions. Use the provider/model form.
# For OpenRouter, set this to an OpenRouter model id prefixed with
# `openrouter/`. `openrouter/auto` lets OpenRouter route per prompt.
KOTA_MODEL=openrouter/openrouter/auto

# Harness used by delegated agent steps. `openai-tools` works with
# OpenAI-compatible providers such as OpenRouter.
KOTA_DEFAULT_AGENT_HARNESS=openai-tools

# Preset override, if you intentionally want one of KOTA's shipped presets.
KOTA_DEFAULT_PRESET=

# Telegram chat autonomy. Keep supervised unless you have hardened
# autonomous writes from chat messages.
KOTA_TELEGRAM_DEFAULT_AUTONOMY_MODE=supervised

# Comma-separated chat id allowlist. Empty defaults to TELEGRAM_ALERT_CHAT_ID.
KOTA_TELEGRAM_ALLOWED_CHAT_IDS=

# OpenRouter key — required when KOTA_MODEL starts with `openrouter/`.
OPENROUTER_API_KEY=

# Anthropic key — optional; only needed when selecting Anthropic-backed models.
ANTHROPIC_API_KEY=

# OpenAI API key — when set, the whisper transcription module registers
# a provider so voice notes reach the agent as transcribed text. Without
# it, voice messages surface a clear user-facing failure rather than a
# silent drop.
OPENAI_API_KEY=
