{
  "id": "builder-targeted-test-writing",
  "description": "Live builder writes tests for correct cart pricing; baseline success and mutation detection grade the tests without prescribed names or manifests.",
  "role": "builder",
  "workflowName": "builder",
  "budgetMs": 1800000,
  "predicates": [
    {
      "kind": "shell-succeeds",
      "command": "node scripts/check-targeted-tests.mjs",
      "timeoutMs": 20000
    },
    {
      "kind": "file-exists",
      "path": "artifacts/test-writing-evidence.json"
    },
    {
      "kind": "file-absent",
      "path": "data/tasks/task-cover-cart-pricing-rules.md"
    },
    {
      "kind": "file-exists",
      "path": "data/tasks/archive/task-cover-cart-pricing-rules.md"
    },
    {
      "kind": "file-contains",
      "path": "data/tasks/archive/task-cover-cart-pricing-rules.md",
      "needle": "status: done"
    },
    {
      "kind": "git-changes-within",
      "allowedPaths": [
        "artifacts/test-writing-evidence.json",
        "test/pricing.test.mjs",
        "data/tasks/task-cover-cart-pricing-rules.md",
        "data/tasks/archive/task-cover-cart-pricing-rules.md"
      ]
    }
  ],
  "objectiveMetrics": [
    {
      "name": "mutations_caught",
      "unit": "mutations",
      "direction": "higher_is_better",
      "source": {
        "kind": "json-file",
        "path": "artifacts/test-writing-evidence.json",
        "pointer": "/mutationsCaught"
      }
    }
  ],
  "verifierCalibration": {
    "null": {
      "setup": []
    },
    "golden": {
      "setup": [
        {
          "kind": "copy-fixture-file",
          "sourcePath": "calibration/golden/test/pricing.test.mjs",
          "targetPath": "test/pricing.test.mjs"
        }
      ]
    },
    "adversarial": {
      "setup": [
        {
          "kind": "copy-fixture-file",
          "sourcePath": "calibration/adversarial/test/pricing.test.mjs",
          "targetPath": "test/pricing.test.mjs"
        }
      ]
    }
  },
  "tags": [
    "autonomy",
    "builder-discipline",
    "test-writing",
    "live-llm",
    "objective-metric"
  ],
  "provenance": {
    "kind": "smoke-fixture",
    "justification": "A model writes tests that pass but fail to detect threshold, tier, or delivery regressions. Deterministic checks can grade a submitted candidate, but cannot establish whether the selected model will discover and produce that candidate. Runtime, task, and workflow invariants remain with their production owners. Choose models/prompts for useful tests-only coding work. No historical KOTA regression is claimed."
  },
  "preRunExpectations": [
    {
      "predicate": {
        "kind": "shell-succeeds",
        "command": "node scripts/check-targeted-tests.mjs",
        "timeoutMs": 20000
      },
      "expected": "fail"
    },
    {
      "predicate": {
        "kind": "file-exists",
        "path": "data/tasks/task-cover-cart-pricing-rules.md"
      },
      "expected": "pass"
    }
  ],
  "controlDecisions": [
    "act"
  ],
  "builderTaskId": "task-cover-cart-pricing-rules"
}
