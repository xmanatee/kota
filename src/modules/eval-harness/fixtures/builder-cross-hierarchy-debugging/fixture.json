    {
      "kind": "file-exists",
      "path": "debug-trace-result.json"
    },
    {
      "kind": "file-contains",
      "path": "debug-trace-result.json",
      "needle": "\"symptom\""
    },
    {
      "kind": "file-contains",
      "path": "debug-trace-result.json",
      "needle": "\"file\": \"src/gateway.mjs\""
    },
    {
      "kind": "file-contains",
      "path": "debug-trace-result.json",
      "needle": "\"rootCause\""
    },
    {
      "kind": "file-contains",
      "path": "debug-trace-result.json",
      "needle": "\"file\": \"src/channel-registry.mjs\""
    },
    {
      "kind": "file-contains",
      "path": "debug-trace-result.json",
      "needle": "\"causalPath\""
    },
    {
      "kind": "file-contains",
      "path": "debug-trace-result.json",
      "needle": "\"verification\""
    },
    {
      "kind": "file-absent",
      "path": "data/tasks/ready/task-fix-cross-hierarchy-signal-routing.md"
    },
    {
      "kind": "file-exists",
      "path": "data/tasks/done/task-fix-cross-hierarchy-signal-routing.md"
    },
    {
      "kind": "file-contains",
      "path": "data/tasks/done/task-fix-cross-hierarchy-signal-routing.md",
      "needle": "status: done"
    },
    {
      "kind": "git-changes-within",
      "allowedPaths": [
        "debug-trace-result.json",
        "src/channel-registry.mjs",
        "data/tasks/ready/task-fix-cross-hierarchy-signal-routing.md",
        "data/tasks/done/task-fix-cross-hierarchy-signal-routing.md"
      ]
    }
  ],
  "objectiveMetrics": [
    {
      "name": "regression_cases_passed",
      "unit": "cases",
      "direction": "higher_is_better",
      "source": {
        "kind": "json-file",
        "path": "debug-trace-result.json",
        "pointer": "/metrics/regressionCasesPassed"
      }
    }
  ],
  "verifierCalibration": {
    "null": {},
    "golden": {
      "setup": [
        {
          "kind": "copy-fixture-file",
          "sourcePath": "calibration/golden/src/channel-registry.mjs",
          "targetPath": "src/channel-registry.mjs"
        },
        {
          "kind": "copy-fixture-file",
          "sourcePath": "calibration/golden/debug-trace-result.json",
          "targetPath": "debug-trace-result.json"
        }
      ]
    },
    "adversarial": {
      "setup": [
        {
          "kind": "copy-fixture-file",
          "sourcePath": "calibration/adversarial/src/channel-registry.mjs",
          "targetPath": "src/channel-registry.mjs"
        },
        {
          "kind": "copy-fixture-file",
          "sourcePath": "calibration/adversarial/debug-trace-result.json",
          "targetPath": "debug-trace-result.json"
        }
      ]
    }
  },
  "tags": [
    "autonomy",
    "builder-discipline",
    "debugging",
    "cross-hierarchy",
    "live-builder",
    "objective-metric"
