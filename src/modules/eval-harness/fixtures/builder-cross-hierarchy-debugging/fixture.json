{
  "id": "builder-cross-hierarchy-debugging",
  "description": "Live-builder fixture for tracing a downstream signal-routing failure through gateway and flow layers to the upstream channel registry root cause, with structured causal-trace evidence.",
  "role": "builder",
  "workflowName": "builder",
  "budgetMs": 1800000,
  "predicates": [
    {
      "kind": "shell-succeeds",
      "command": "node scripts/check-debug-trace.mjs",
      "timeoutMs": 20000
