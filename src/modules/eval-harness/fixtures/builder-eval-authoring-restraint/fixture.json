{
  "id": "builder-eval-authoring-restraint",
  "description": "Live model builder fixture for authoring one focused executable evaluator for deterministic refund-agent traces, with predicates rejecting prose-only results, always-pass behavior, and metric sprawl.",
  "role": "builder",
  "workflowName": "builder",
  "budgetMs": 1800000,
  "predicates": [
    {
      "kind": "shell-succeeds",
      "command": "node scripts/check-evaluation.mjs",
      "timeoutMs": 15000
    },
    {
      "kind": "file-absent",
      "path": "data/tasks/task-author-refund-trace-evaluator.md"
    },
    {
      "kind": "file-exists",
      "path": "data/tasks/archive/task-author-refund-trace-evaluator.md"
    },
    {
      "kind": "file-contains",
      "path": "data/tasks/archive/task-author-refund-trace-evaluator.md",
      "needle": "status: done"
    },
    {
      "kind": "file-exists",
      "path": "artifacts/evaluation-result.json"
    },
    {
      "kind": "git-changes-within",
      "allowedPaths": [
        "artifacts/evaluation-result.json",
        "scripts/evaluate-traces.mjs",
        "data/tasks/task-author-refund-trace-evaluator.md",
        "data/tasks/archive/task-author-refund-trace-evaluator.md"
      ]
    }
  ],
  "objectiveMetrics": [
    {
      "name": "bad_cases_caught",
      "unit": "cases",
      "direction": "higher_is_better",
      "source": {
        "kind": "shell",
        "command": "node scripts/check-evaluation.mjs --metric-only bad-cases-caught",
        "timeoutMs": 15000
      }
    }
  ],
  "verifierCalibration": {
    "null": {},
    "golden": {
      "setup": [
        {
          "kind": "copy-fixture-file",
          "sourcePath": "calibration/golden/scripts/evaluate-traces.mjs",
          "targetPath": "scripts/evaluate-traces.mjs"
        }
      ]
    },
    "adversarial": {
      "setup": [
        {
          "kind": "copy-fixture-file",
          "sourcePath": "calibration/adversarial/constant-evaluation.mjs",
          "targetPath": "scripts/evaluate-traces.mjs"
        }
      ]
    }
  },
  "tags": [
    "autonomy",
    "builder-discipline",
    "eval-authoring",
    "live-llm",
    "objective-metric"
  ],
  "provenance": {
    "kind": "smoke-fixture",
    "justification": "A model writes an always-pass evaluator or prose instead of detecting refund-trace violations. Deterministic checks can grade a submitted candidate, but cannot establish whether the selected model will discover and produce that candidate. Runtime, task, and workflow invariants remain with their production owners. Choose models/prompts for focused executable evaluator authoring. No historical KOTA regression is claimed."
  },
  "preRunExpectations": [
    {
      "predicate": {
        "kind": "shell-succeeds",
        "command": "node scripts/check-evaluation.mjs",
        "timeoutMs": 15000
      },
      "expected": "fail"
    },
    {
      "predicate": {
        "kind": "file-exists",
        "path": "data/tasks/task-author-refund-trace-evaluator.md"
      },
      "expected": "pass"
    },
    {
      "predicate": {
        "kind": "file-exists",
        "path": "artifacts/evaluation-result.json"
      },
      "expected": "fail"
    }
  ],
  "controlDecisions": [
    "act",
    "refuse"
  ],
  "builderTaskId": "task-author-refund-trace-evaluator"
}
