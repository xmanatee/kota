{
  "id": "builder-scientific-claim-reproduction",
  "description": "Builder reconstructs a small paper-like claim analysis from local data, produces machine-readable claim evidence, and distinguishes support from refutation through deterministic predicates.",
  "role": "builder",
  "workflowName": "builder",
  "budgetMs": 1800000,
  "predicates": [
    {
      "kind": "lx12-scientific-claim-result",
      "mainPath": "claim-result.json",
      "holdoutPath": "claim-holdout-result.json",
      "maxErrorPct": 1e-06
    },
    {
      "kind": "file-exists",
      "path": "claim-result.json"
    },
    {
      "kind": "file-absent",
      "path": "data/tasks/task-reproduce-lx12-biomass-claim.md"
    },
    {
      "kind": "file-exists",
      "path": "data/tasks/archive/task-reproduce-lx12-biomass-claim.md"
    },
    {
      "kind": "file-contains",
      "path": "data/tasks/archive/task-reproduce-lx12-biomass-claim.md",
      "needle": "status: done"
    },
    {
      "kind": "git-changes-within",
      "allowedPaths": [
        "scripts/analyze-claim.mjs",
        "claim-result.json",
        "claim-holdout-result.json",
        "data/tasks/task-reproduce-lx12-biomass-claim.md",
        "data/tasks/archive/task-reproduce-lx12-biomass-claim.md"
      ]
    }
  ],
  "objectiveMetrics": [
    {
      "name": "median_uplift_pct",
      "unit": "percent",
      "direction": "higher_is_better",
      "source": {
        "kind": "json-file",
        "path": "claim-result.json",
        "pointer": "/metric/value"
      }
    }
  ],
  "verifierCalibration": {
    "null": {},
    "golden": {
      "setup": [
        {
          "kind": "copy-fixture-file",
          "sourcePath": "calibration/golden/claim-result.json",
          "targetPath": "claim-result.json"
        },
        {
          "kind": "copy-fixture-file",
          "sourcePath": "calibration/golden/claim-holdout-result.json",
          "targetPath": "claim-holdout-result.json"
        },
        {
          "kind": "copy-fixture-file",
          "sourcePath": "calibration/analyze-claim.mjs",
          "targetPath": "scripts/analyze-claim.mjs"
        }
      ]
    },
    "acceptedAlternatives": [
      {
        "id": "audited-json-evidence",
        "setup": [
          {
            "kind": "copy-fixture-file",
            "sourcePath": "calibration/accepted-alternatives/audited-json-evidence/claim-result.json",
            "targetPath": "claim-result.json"
          },
          {
            "kind": "copy-fixture-file",
            "sourcePath": "calibration/accepted-alternatives/audited-json-evidence/claim-holdout-result.json",
            "targetPath": "claim-holdout-result.json"
          },
          {
            "kind": "copy-fixture-file",
            "sourcePath": "calibration/analyze-claim.mjs",
            "targetPath": "scripts/analyze-claim.mjs"
          }
        ]
      }
    ],
    "adversarial": {
      "setup": [
        {
          "kind": "copy-fixture-file",
          "sourcePath": "calibration/adversarial/claim-result.json",
          "targetPath": "claim-result.json"
        },
        {
          "kind": "copy-fixture-file",
          "sourcePath": "calibration/adversarial/claim-holdout-result.json",
          "targetPath": "claim-holdout-result.json"
        }
      ]
    }
  },
  "tags": [
    "autonomy",
    "builder-discipline",
    "scientific-claim",
    "objective-metric",
    "live-llm"
  ],
  "provenance": {
    "kind": "smoke-fixture",
    "justification": "A model repeats expected claim numbers instead of computing the required procedure on both datasets. Deterministic checks can grade a submitted candidate, but cannot establish whether the selected model will discover and produce that candidate. Runtime, task, and workflow invariants remain with their production owners. Choose models/prompts for reproducible quantitative research. No historical KOTA regression is claimed."
  },
  "preRunExpectations": [
    {
      "predicate": {
        "kind": "lx12-scientific-claim-result",
        "mainPath": "claim-result.json",
        "holdoutPath": "claim-holdout-result.json",
        "maxErrorPct": 1e-06
      },
      "expected": "fail"
    },
    {
      "predicate": {
        "kind": "file-exists",
        "path": "data/tasks/task-reproduce-lx12-biomass-claim.md"
      },
      "expected": "pass"
    }
  ],
  "controlDecisions": [
    "act"
  ],
  "builderTaskId": "task-reproduce-lx12-biomass-claim"
}
