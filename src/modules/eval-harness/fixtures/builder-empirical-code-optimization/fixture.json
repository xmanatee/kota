{
  "id": "builder-empirical-code-optimization",
  "description": "Builder improves a small forecasting implementation against a deterministic holdout MAE score, with objective metric evidence reported from the fixture working directory.",
  "role": "builder",
  "workflowName": "builder",
  "budgetMs": 1800000,
  "predicates": [
    {
      "kind": "shell-succeeds",
      "command": "node scripts/score.mjs --max-holdout-mae 0.25",
      "timeoutMs": 10000
    },
    {
      "kind": "file-absent",
      "path": "data/tasks/task-improve-forecast-predictor.md"
    },
    {
      "kind": "file-exists",
      "path": "data/tasks/archive/task-improve-forecast-predictor.md"
    },
    {
      "kind": "file-contains",
      "path": "data/tasks/archive/task-improve-forecast-predictor.md",
      "needle": "status: done"
    },
    {
      "kind": "git-changes-within",
      "allowedPaths": [
        "src/predictor.mjs",
        "data/tasks/task-improve-forecast-predictor.md",
        "data/tasks/archive/task-improve-forecast-predictor.md"
      ]
    }
  ],
  "objectiveMetrics": [
    {
      "name": "forecast_mae",
      "unit": "mae",
      "direction": "lower_is_better",
      "source": {
        "kind": "shell",
        "command": "node scripts/score.mjs --metric-only",
        "timeoutMs": 10000
      }
    }
  ],
  "verifierCalibration": {
    "null": {},
    "golden": {
      "setup": [
        {
          "kind": "copy-fixture-file",
          "sourcePath": "calibration/golden/src/predictor.mjs",
          "targetPath": "src/predictor.mjs"
        }
      ]
    },
    "acceptedAlternatives": [
      {
        "id": "coefficient-object",
        "setup": [
          {
            "kind": "copy-fixture-file",
            "sourcePath": "calibration/accepted-alternatives/coefficient-object/src/predictor.mjs",
            "targetPath": "src/predictor.mjs"
          }
        ]
      }
    ],
    "adversarial": {
      "setup": [
        {
          "kind": "copy-fixture-file",
          "sourcePath": "calibration/adversarial/src/predictor.mjs",
          "targetPath": "src/predictor.mjs"
        }
      ]
    }
  },
  "tags": [
    "autonomy",
    "builder-discipline",
    "empirical-code",
    "live-llm",
    "objective-metric"
  ],
  "provenance": {
    "kind": "smoke-fixture",
    "justification": "A model changes a predictor without improving held-out numerical error. Deterministic checks can grade a submitted candidate, but cannot establish whether the selected model will discover and produce that candidate. Runtime, task, and workflow invariants remain with their production owners. Choose models/prompts for measured optimization work. No historical KOTA regression is claimed."
  },
  "preRunExpectations": [
    {
      "predicate": {
        "kind": "shell-succeeds",
        "command": "node scripts/score.mjs --max-holdout-mae 0.25",
        "timeoutMs": 10000
      },
      "expected": "fail"
    },
    {
      "predicate": {
        "kind": "file-exists",
        "path": "data/tasks/task-improve-forecast-predictor.md"
      },
      "expected": "pass"
    }
  ],
  "controlDecisions": [
    "act"
  ],
  "builderTaskId": "task-improve-forecast-predictor"
}
