{
  "name": "kota-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "start": "node scripts/expo.mjs start",
    "build": "node scripts/expo.mjs export --platform android --output-dir dist",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "jest --ci",
    "test:watch": "jest --watch",
    "check": "pnpm typecheck && pnpm test",
    "check:all": "pnpm check && pnpm build",
    "android": "node scripts/expo.mjs start --android",
    "evidence:android-server": "node scripts/android-ui-evidence-server.mjs",
    "ios": "node scripts/expo.mjs start --ios",
    "web": "node scripts/expo.mjs start --web"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "~52.0.0",
    "expo-av": "~15.0.2",
    "expo-camera": "~16.0.18",
    "expo-file-system": "18.0.12",
    "expo-notifications": "~0.29.0",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "@types/react-test-renderer": "^19.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.6",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.3.3"
  }
}
