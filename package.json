{
  "name": "kota",
  "version": "0.1.0",
  "mcpName": "io.github.xmanatee/kota",
  "packageManager": "pnpm@10.32.1",
  "description": "KOTA — a local-first agent automation runtime and operator control plane.",
  "type": "module",
  "bin": {
    "kota": "./bin/kota.mjs"
  },
  "imports": {
    "#core/*.js": {
      "source": "./src/core/*.ts",
      "default": "./dist/core/*.js"
    },
    "#modules/*.js": {
      "source": "./src/modules/*.ts",
      "default": "./dist/modules/*.js"
    },
    "#root/*.js": {
      "source": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    "./module": {
      "types": "./dist/module-api.d.ts",
      "default": "./dist/module-api.js"
    },
    "./testing": {
      "types": "./dist/core/workflow/testing/testing-api.d.ts",
      "default": "./dist/core/workflow/testing/testing-api.js"
    }
  },
  "files": [
    "bin/",
    "dist/",
    "schema/*.json"
  ],
  "scripts": {
    "dev": "node --conditions=source --import tsx src/cli.ts",
    "build": "pnpm check:ui-bindings && rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-runtime-assets.mjs",
    "prepack": "pnpm build",
    "typecheck": "pnpm typecheck:production && pnpm typecheck:tests",
    "typecheck:production": "tsc --noEmit -p tsconfig.build.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "check": "pnpm check:fast && pnpm build && pnpm test",
    "check:fast": "pnpm typecheck && pnpm lint && pnpm validate-tasks",
    "test": "TMPDIR=\"$(cd \"${TMPDIR:-/tmp}\" && pwd -P)\" NODE_OPTIONS=--conditions=source vitest run --configLoader runner --silent=true",
    "test:owner": "TMPDIR=\"$(cd \"${TMPDIR:-/tmp}\" && pwd -P)\" NODE_OPTIONS=--conditions=source vitest run --configLoader runner --silent=true --project=owner --project=cli",
    "test:integration": "TMPDIR=\"$(cd \"${TMPDIR:-/tmp}\" && pwd -P)\" NODE_OPTIONS=--conditions=source vitest run --configLoader runner --silent=true --project=integration",
    "test:eval": "TMPDIR=\"$(cd \"${TMPDIR:-/tmp}\" && pwd -P)\" NODE_OPTIONS=--conditions=source vitest run --configLoader runner --silent=true --project=eval",
    "test:changed": "TMPDIR=\"$(cd \"${TMPDIR:-/tmp}\" && pwd -P)\" NODE_OPTIONS=--conditions=source vitest run --configLoader runner --silent=true --changed",
    "test:preset-parity": "NODE_OPTIONS=--conditions=source vitest run src/preset-parity-model-sweep.integration.test.ts src/preset-parity.integration.test.ts",
    "lint": "biome check src/ && biome lint clients/mobile/src/daemon/",
    "lint:fix": "biome check --write src/ && biome lint clients/mobile/src/daemon/",
    "build:schema": "node --conditions=source --import tsx src/core/config/build-schema.ts",
    "build:ui-bindings": "node scripts/generate-ui-surface-bindings.mjs",
    "check:ui-bindings": "node scripts/generate-ui-surface-bindings.mjs --check",
    "build:client-bindings": "pnpm build:ui-bindings && node scripts/generate-daemon-contract-bindings.mjs",
    "check:client-bindings": "pnpm check:ui-bindings && node scripts/generate-daemon-contract-bindings.mjs --check",
    "hygiene": "node --conditions=source --import tsx src/check-hygiene.ts",
    "validate-tasks": "node --conditions=source --import tsx src/validate-queue.ts",
    "kota": "node --conditions=source --import tsx src/cli.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.58",
    "@anthropic-ai/claude-agent-sdk": "^0.2.141",
    "@anthropic-ai/sdk": "^0.93.0",
    "@google/genai": "^1.51.0",
    "@openai/agents": "0.8.5",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@types/node": "^22.0.0",
    "ai": "^6.0.174",
    "better-sqlite3": "^13.0.3",
    "commander": "^13.1.0",
    "glob": "^13.0.6",
    "nodemailer": "^9.0.5",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^5.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/nodemailer": "^6.4.0",
    "@types/qrcode-terminal": "^0.12.2",
    "ts-json-schema-generator": "^2.9.0",
    "tsx": "^4.23.12",
    "vitest": "^4.1.0"
  },
  "optionalDependencies": {
    "playwright": "^1.60.0"
  }
}
